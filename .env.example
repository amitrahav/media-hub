# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api)
# Used in the browser for trailers, recommendations, cast and filmographies.
VITE_TMDB_TOKEN=

# Trakt app (https://trakt.tv/oauth/applications) — redirect uri: urn:ietf:wg:oauth:2.0:oob
# The client id is public; the secret stays on the Node server.
VITE_TRAKT_CLIENT_ID=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

PORT=8787

# ---- Raspberry Pi / TV (optional) ----
# Sign in to Stremio from here so nobody has to type a password with the TV remote.
# Only handed to a browser running on this same device.
STREMIO_EMAIL=
STREMIO_PASSWORD=
# Extra addon manifest URLs, comma-separated (e.g. Torrentio configured with your debrid key).
MEDIAHUB_ADDONS=
# UI scale for the kiosk (1 for a 1080p TV; try 1.5–2 if your Pi outputs 4K).
MEDIAHUB_SCALE=1
# Extra mpv flags, e.g. "--hwdec=drm-copy" or "--vo=gpu-next".
MPV_EXTRA_ARGS=
