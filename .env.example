# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api)
# Used in the browser for trailers, recommendations, cast and filmographies.
VITE_TMDB_TOKEN=

# Trakt app (https://trakt.tv/oauth/applications) — redirect uri: urn:ietf:wg:oauth:2.0:oob
# The client id is public; the secret stays on the Node server.
VITE_TRAKT_CLIENT_ID=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

PORT=8787
