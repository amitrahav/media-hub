{
  "name": "media-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Netflix / Apple TV style skin over Stremio addons with debrid streams, TMDB discovery and Trakt scrobbling",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "hls.js": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
